# Configurazione Server
PORT=3333
NODE_ENV=development

# Database MongoDB
# Per sviluppo con Docker (con autenticazione)
MONGODB_URI=mongodb://chat_user:chat_password123@localhost:27017/chat_organizer


# Chat separata per messaggi filtrati
FORWARD_ENABLE_WHATSAPPWEBJS=true
ADMIN_PHONE_NUMBERS=+393476835437

USE_MEMORY_STORAGE=true
MEMORY_MAX_MESSAGES=1000
DEFAULT_FILTERS=[
  {
    "name": "forward",
    "description": "i nuovi messaggi vengono inoltrati in un numero separato, con: sourceGroups e possibile specificare quali gruppi o numeri attenzionare",
    "authors": [],
    "sourceGroups": [
      "NLF Li-gue",
      "G2"
    ],
    "actions": {
      "addTags": [
        "Messagio non duplicato"
      ],
      "forwardTo": [
        "+393476835437"
      ]
    },
    "enabled": true,
    "uniqueText": {
      "enabled": true,
      "timeWindowSeconds": 120
    }
  }
]

# Configurazione gruppi WhatsApp (whatsapp-web.js)
WHATSAPP_GROUPS_ALL=true


# WhatsApp App Configuration (per refresh token automatico)
WHATSAPP_APP_ID=your_app_id_here
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_REFRESH_TOKEN=your_long_lived_token_here
